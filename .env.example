# Shopify Storefront API, public token (Headless channel). Public by design: the Buy Button cart uses it in the browser.
PUBLIC_SHOPIFY_STORE_DOMAIN=adbits.ca
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Shopify Admin API, server only: custom app that lists and creates customers' finalized designs.
# Scopes: read_products, write_products, write_publications.
SHOPIFY_ADMIN_DOMAIN=jvvkum-8d.myshopify.com
SHOPIFY_ADMIN_TOKEN=

# Optional: show another customer's designs while customer login is a placeholder (src/lib/server/customer.ts).
DEV_CUSTOMER_EMAIL=

# Publication the Storefront token reads (Headless channel); designs not published to it can't go in the cart.
SHOPIFY_STOREFRONT_PUBLICATION_ID=gid://shopify/Publication/285776576816

# Customer login (Customer Account API, Headless channel). Encrypts the login cookie: any long random string.
SESSION_SECRET=
# Public https URL of this app, e.g. https://slicer.adbits.ca. Required in production (the Node server
# rejects uploads without it behind a proxy) and for the login callback; in dev, set it to your tunnel URL.
ORIGIN=

# OrcaSlicer, used for accurate FDM quotes and to build the finalized 3MF files.
# Defaults: C:\Program Files\OrcaSlicer\orca-slicer.exe on Windows, else `orca-slicer` on PATH;
# profiles from resources/profiles next to the executable (set it if that's not where they are).
ORCA_SLICER_PATH=
ORCA_PROFILES_DIR=
# Where quotes (kept 24 h) and finalized models are stored. Defaults: ./data and DATA_DIR/models.
DATA_DIR=
MODELS_DIR=
